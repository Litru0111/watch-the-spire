# 统一换行符，避免 Windows 上提交把整个仓库刷成 CRLF
* text=auto eol=lf

# Windows 批处理必须保留 CRLF
*.cmd text eol=crlf
*.bat text eol=crlf

# 二进制
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.db binary
*.pck binary
*.dll binary

# 让 GitHub 语言统计把 HTML 单独算，不要把项目标成纯 JS
*.html linguist-detectable=true
*.mjs linguist-detectable=true
